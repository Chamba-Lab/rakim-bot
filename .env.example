# Copia este archivo a .env y completa los valores. Nunca subas .env al repo.
# Los IDs se copian en Discord con el Modo desarrollador activo (clic derecho > Copiar ID).

# Token del bot (portal de desarrolladores > Bot > Reset Token)
DISCORD_TOKEN=

# Servidor donde opera Rakim. Si el bot está en otro servidor, lo ignora.
GUILD_ID=

# Canal general: ahí saluda a quien termina la pantalla de reglas
WELCOME_CHANNEL_ID=
# Canales que menciona el mensaje de bienvenida
INTRO_CHANNEL_ID=
ASK_FEEDBACK_CHANNEL_ID=
LINKS_CHANNEL_ID=

# true: el saludo espera al mensaje nativo de Discord («X ha entrado») para salir después.
# false: úsalo si desactivas esos mensajes; el saludo sale tras una pausa fija de unos segundos.
WELCOME_WAIT_SYSTEM_MESSAGE=true

# Canal privado donde se registran las entradas y salidas
LOG_CHANNEL_ID=

# Canal donde Rakim recuerda hacer bump; el rol y la persona son opcionales (se mencionan en el aviso)
BUMP_CHANNEL_ID=
BUMP_ROLE_ID=
BUMP_USER_ID=
# Bot que gestiona el bump (Disboard) y texto que indica un bump exitoso (expresión regular, sin distinguir mayúsculas)
DISBOARD_BOT_ID=302050872383242240
BUMP_SUCCESS_PATTERN=bump done
# Enfriamiento entre bumps, en minutos
BUMP_COOLDOWN_MINUTES=120

# Nombres legibles para las invitaciones del log, como JSON {"codigo":"nombre"}
INVITE_LABELS={}

# Tema del día en el canal general (WELCOME_CHANNEL_ID). Horas de Lima (UTC-5), HH:MM,
# separadas por coma; vacío lo apaga. En la comunidad: 18:00.
DAILY_TOPIC_TIMES=
# Rol a mencionar (🎲 Actividades), opcional. Rakim necesita «Mencionar @everyone, @here y
# todos los roles» en el canal general, o que el rol sea mencionable por cualquiera.
DAILY_TOPIC_ROLE_ID=
# Grupos de rakim/roulette.json de los que salen los temas (por id, separados por coma)
DAILY_TOPIC_PRESETS=employability,icebreaker-culture,daily-learning

# Roles de las preguntas del Onboarding que cuenta /miembros, separados por coma
# (país: Perú, Colombia…; etapa: Early Career, Mid level, Senior). Vacíos: esa tabla no sale.
COUNTRY_ROLE_IDS=
STAGE_ROLE_IDS=

# Archivo donde el bot guarda su estado (el aviso de bump pendiente y los temas del día ya usados)
STATE_PATH=data/state.json
