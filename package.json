{
    "name": "rakim-bot",
    "private": true,
    "type": "module",
    "version": "0.0.0",
    "description": "Rakim Bot: Discord bot of the Chamba Lab community",
    "license": "UNLICENSED",
    "engines": {
        "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
    },
    "scripts": {
        "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
        "build": "tsc -p tsconfig.build.json",
        "start": "node --env-file-if-exists=.env dist/index.js",
        "typecheck": "tsc --noEmit",
        "lint": "eslint . && prettier --check .",
        "lint:fix": "eslint . --fix && prettier --write .",
        "test": "vitest run"
    },
    "dependencies": {
        "discord.js": "^14.27.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^22.20.5",
        "eslint": "^10.13.0",
        "prettier": "^3.9.10",
        "tsx": "^4.23.15",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1",
        "vitest": "^5.0.5"
    }
}
